<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002-create-military-units" author="naumenko">
        <createTable tableName="military_units">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="location" type="VARCHAR(255)"/>
            <column name="formation_date" type="DATE"/>

            <column name="unit_type_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="parent_unit_id" type="BIGINT"/>

            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="military_units" baseColumnNames="unit_type_id"
                                 referencedTableName="unit_types" referencedColumnNames="id"
                                 constraintName="fk_units_type"/>

        <addForeignKeyConstraint baseTableName="military_units" baseColumnNames="parent_unit_id"
                                 referencedTableName="military_units" referencedColumnNames="id"
                                 constraintName="fk_units_parent"/>
    </changeSet>
</databaseChangeLog>